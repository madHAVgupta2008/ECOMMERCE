# ── RakhiRoots Environment Variables ──────────────────────────────────────────
# This file is a TEMPLATE only. Do NOT put real values here.
# Real values go in the Render Dashboard → Environment tab ONLY.
# NEVER commit real credentials to git.

# MongoDB connection string (required)
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster.mongodb.net/rakhiroots

# JWT secret — use a long, random string (CRITICAL: change before going live)
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=PASTE_YOUR_GENERATED_RANDOM_STRING_HERE

# Admin credentials (CRITICAL: change before going live)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YOUR_STRONG_PASSWORD_HERE

# Your production domain (used for CORS)
ALLOWED_ORIGIN=https://your-app-name.onrender.com

# Port (optional — do NOT set this on Render, Render manages it automatically)
# PORT=3000

# ── Cloudinary (Image CDN) ─────────────────────────────────────────────────────
# Sign up free at https://cloudinary.com — Free tier gives 25 GB storage
# Find these in your Cloudinary Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
